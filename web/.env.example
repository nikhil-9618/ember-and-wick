# Copy to .env.local for development. Never commit real credentials.

# Public site origin, used for canonical URLs, sitemap and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side origin used for absolute links and auth checks.
APP_ORIGIN=http://localhost:3000

# Database. `next dev` falls back to mongodb://127.0.0.1:27017/emberandwick, so
# start a local MongoDB replica set (transactions require one). On Vercel set
# the Atlas connection string instead; the database name defaults to the path
# in the URI, or to `emberandwick` when the URI has no path.
MONGODB_URI=
MONGODB_DB=
# Set to 1 on the first hosted request so the indexes and catalogue are applied.
BOOTSTRAP_DB=

# Payments: "razorpay" uses the keys below; "test" enables the test-only
# confirmation flow and is refused when NODE_ENV=production.
PAYMENT_PROVIDER=test

# Razorpay credentials (server-side only). Never expose the secret to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Verification and password-reset codes. Set ONE provider key (all free):
#   BREVO_API_KEY=xkeysib-...      300 emails/day, no domain needed (see below)
#   MAILERSEND_API_KEY=mlsn....    free trial domain, no DNS needed
#   RESEND_API_KEY=re_...          3000/month, needs a verified domain
#
# No domain yet? Use Brevo with a mailbox you already own:
#   1. Create a free Brevo account, open Senders, add that address (for example
#      store@gmail.com) and type the 6-digit code Brevo emails to it.
#   2. OTP_FROM_EMAIL=store@gmail.com, EMAIL_PROVIDER=brevo, BREVO_API_KEY=...
# Brevo cannot authenticate a free domain, so it replaces such a sender with its
# own authenticated domain (<account>.brevosend.com). Codes still reach real
# inboxes, and the message never claims to come from a mailbox the store does
# not control.
#
# Own a domain? Authenticate it with the provider (Brevo: Senders -> Domains;
# Resend: Domains), set OTP_FROM_EMAIL to that address, and mail carries your
# brand. A free-mailbox sender is only accepted with Brevo; Resend and
# MailerSend reject it and say so before sending.
#
# EMAIL_PROVIDER=brevo|mailersend|resend selects the provider explicitly, which
# matters when a key exists but its domain is not verified yet. Unset, it uses
# the first configured key in that order.
#
# Without a provider key and a usable sender, sign-up and password reset fail
# closed with a clear message; there is no on-screen code fallback.
OTP_FROM_EMAIL=
EMAIL_FROM_NAME=Ember & Wick
# Optional Reply-To address, e.g. hello@your-domain.com.
EMAIL_REPLY_TO=
EMAIL_PROVIDER=
BREVO_API_KEY=
MAILERSEND_API_KEY=
RESEND_API_KEY=

# Optional: point Resend delivery at another Resend-compatible gateway. The API
# integration suite uses it to capture codes locally instead of sending mail.
EMAIL_API_BASE=

# Demo only: create the published demo accounts (admin/manager/customer) on the
# first request of a deployed database.
SEED_DEMO_ACCOUNTS=

# Refunds at or above this amount (paise) need approval from a second admin.
# Defaults to 500000 (₹5,000) when unset or invalid. Set 0 to disable approval.
REFUND_APPROVAL_THRESHOLD_PAISE=

# Only needed for `next dev` when loading a preview hostname.
PREVIEW_HOST=
